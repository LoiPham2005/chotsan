# Tiến trình chạy job nền (BullMQ).
#
# Cài đặt:
#   sudo cp deploy/chotsan-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now chotsan-worker
#
# Xem log:  journalctl -u chotsan-worker -f
#
# ⚠️ Worker BẮT BUỘC có REDIS_URL trong /etc/chotsan/env. Khác web và
# realtime, nó không có việc gì để làm nếu thiếu hàng đợi — và sẽ dừng ngay với
# thông báo rõ ràng thay vì ngồi im trông như đang hoạt động.
#
# ⚠️ DỰ ÁN KHÔNG DÙNG HÀNG ĐỢI (`QUEUE_ENABLED=0`): tắt Ở TẦNG UNIT, đừng chỉ
# sửa biến môi trường. `scripts/deploy-vps.sh` đọc cờ và tự làm việc này; tắt tay:
#
#   sudo systemctl disable --now chotsan-worker
#
# Đặt QUEUE_ENABLED=0 trong file env thì tiến trình tự thoát với mã 0 kèm lời
# giải thích — nhưng `Restart=always` bật lại nó ngay lập tức. Nó sẽ quay vòng
# cho tới khi chạm StartLimitBurst rồi vào trạng thái `failed`: ồn ào, và không
# phải thứ bạn muốn thấy chỉ vì đã tắt một tính năng có chủ đích.
#
# Tắt worker KHÔNG làm mất job theo lịch: khi đó tiến trình web tự chạy lịch
# (`features.schedules` = `in-process` ở /api/health).

[Unit]
Description=ChốtSân worker (job nền)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

# Dừng hẳn nếu crash liên tục. Hai khoá này phải ở [Unit], KHÔNG phải
# [Service] — systemd đã chuyển chúng sang đây từ bản 229.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/chotsan

EnvironmentFile=/etc/chotsan/env
Environment=NODE_ENV=production

# Như realtime: bundle chỉ gồm mã dự án, gói npm (bullmq, ioredis, @prisma/client…)
# lấy từ node_modules của thư mục dự án. `/health` nghe 127.0.0.1 (biến `HOST`).
ExecStart=/usr/bin/node worker/dist/worker.cjs

Restart=always
RestartSec=5

# Cho worker chạy nốt job đang dở trước khi bị giết.
#
# Mặc định systemd đợi 90 giây rồi SIGKILL. Đặt rõ ở đây để con số này là một
# quyết định, không phải một mặc định tình cờ: cắt ngang job đã trừ tiền nhưng
# chưa ghi nhận là để lại dữ liệu sai. Job dài hơn thì nâng lên.
TimeoutStopSec=60

# Tác vụ nền, không ai đợi — nhường CPU và I/O cho request thật.
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

# Siết quyền giống hai unit kia.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/www/chotsan/worker/dist

StandardOutput=journal
StandardError=journal
SyslogIdentifier=chotsan-worker

[Install]
WantedBy=multi-user.target
