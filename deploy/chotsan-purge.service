# Dọn dữ liệu chỉ-tăng (token hết hạn, nhật ký cũ, thiết bị chết). Chạy theo
# lịch của `chotsan-purge.timer`.
#
# KHÔNG bắt buộc: lịch `maintenance-purge-expired` (worker, hoặc chính web khi
# QUEUE_ENABLED=0) đã dọn mỗi ngày bằng CÙNG handler. Timer này là lưới dự phòng
# cho cấu hình không ai chạy lịch (`features.schedules` = `off`).
#
# Cài đặt (trên VPS, sau khi đã cài chotsan.service):
#   sudo cp deploy/chotsan-purge.service deploy/chotsan-purge.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now chotsan-purge.timer
#
# Kiểm tra:
#   systemctl list-timers chotsan-purge.timer
#   journalctl -u chotsan-purge.service -n 50

[Unit]
Description=ChốtSân — dọn token, nhật ký và thiết bị đã hết hạn
# Không cần chờ ứng dụng: script này nói chuyện thẳng với database.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/var/www/chotsan

EnvironmentFile=/etc/chotsan/env
Environment=NODE_ENV=production

# Dùng pnpm chứ không gọi thẳng node: script chạy qua tsx với tsconfig riêng
# (xem tsconfig.scripts.json), nên để package.json giữ đúng một nguồn sự thật
# về cách gọi.
ExecStart=/usr/bin/env pnpm db:purge

# Tác vụ nền, không ai đợi kết quả — nhường CPU và I/O cho request thật.
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=chotsan-purge
