// ChốtSân — schema.
// Quy ước: mọi cột thời gian dùng @db.Timestamptz(3).
// Chi tiết vì sao 21 bảng nghiệp vụ: docs/THIET_KE_LAI.md §3

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  level       Int              @default(0)
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  userRoles   UserRole[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@index([level])
  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  name            String
  category        String
  description     String?
  roles           RolePermission[]
  userPermissions UserPermission[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedBy String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserPermission {
  userId       String
  permissionId String
  isGranted    Boolean    @default(true)
  grantedBy    String?
  expiresAt    DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@index([expiresAt])
  @@map("user_permissions")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

model User {
  id                  String                  @id @default(cuid())
  email               String?
  phone               String?
  username            String?
  password            String?
  status              UserStatus              @default(ACTIVE)
  emailVerifiedAt     DateTime?               @db.Timestamptz(3)
  phoneVerifiedAt     DateTime?               @db.Timestamptz(3)
  pendingEmail        String?
  passwordChangedAt   DateTime?               @db.Timestamptz(3)
  failedLoginAttempts Int                     @default(0)
  lockedUntil         DateTime?               @db.Timestamptz(3)
  deletedAt           DateTime?               @db.Timestamptz(3)
  twoFactorSecret     String?
  twoFactorEnabledAt  DateTime?               @db.Timestamptz(3)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  profile             UserProfile?
  userRoles           UserRole[]
  userPermissions     UserPermission[]
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  oauthAccounts       OAuthAccount[]
  recoveryCodes       RecoveryCode[]
  passkeys            WebAuthnCredential[]
  devices             UserDevice[]
  notifications       NotificationRecipient[]
  venueMembers        VenueMember[]
  bookings            Booking[]
  reviews             Review[]
  favorites           Favorite[]

  @@index([email])
  @@index([phone])
  @@index([username])
  @@index([status])
  @@index([deletedAt, createdAt])
  @@map("users")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model UserProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String?
  avatarUrl String?
  gender    Gender?
  dob       DateTime? @db.Date
  bio       String?
  address   String?
  city      String?
  district  String?
  country   String?   @default("VN")
  metadata  Json?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@map("user_profiles")
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([userId, codeHash])
  @@index([userId])
  @@map("recovery_codes")
}

model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String
  counter      BigInt    @default(0)
  deviceType   String
  backedUp     Boolean   @default(false)
  transports   String[]
  aaguid       String?
  name         String?
  lastUsedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("webauthn_credentials")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id          String      @id @default(cuid())
  familyId    String
  tokenHash   String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String?
  userAgent   String?
  ip          String?
  twoFactorAt DateTime?   @db.Timestamptz(3)
  expiresAt   DateTime    @db.Timestamptz(3)
  revokedAt   DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  device      UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  EMAIL_CHANGE
  PHONE_OTP
  PASSWORD_RESET
}

model VerificationToken {
  id          String                @id @default(cuid())
  tokenHash   String                @unique
  type        VerificationTokenType
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination String?
  attempts    Int                   @default(0)
  expiresAt   DateTime              @db.Timestamptz(3)
  usedAt      DateTime?             @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

model UserDevice {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform      DevicePlatform
  fcmToken      String         @unique
  deviceId      String?
  deviceName    String?
  isActive      Boolean        @default(true)
  lastSeenAt    DateTime       @default(now()) @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("user_devices")
}

enum NotificationType {
  DIRECT
  TOPIC
  BROADCAST
}

model Notification {
  id         String                  @id @default(cuid())
  title      String
  body       String
  imageUrl   String?
  type       NotificationType        @default(DIRECT)
  actionUrl  String?
  data       Json?
  senderId   String?
  createdAt  DateTime                @default(now()) @db.Timestamptz(3)
  recipients NotificationRecipient[]

  @@index([type, createdAt])
  @@map("notifications")
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  isRead         Boolean      @default(false)
  readAt         DateTime?    @db.Timestamptz(3)
  isPushed       Boolean      @default(false)
  pushedAt       DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notification_recipients")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Sport {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  venues    Venue[]
  courts    Court[]

  @@map("sports")
}

enum VenueStatus {
  DRAFT
  PENDING
  ACTIVE
  // Chủ sân tự tạm nghỉ — chủ sân tự mở lại được.
  SUSPENDED
  UNDER_MAINTENANCE
  // ⚠️ Admin khoá vì vi phạm. CHỈ admin gỡ được — xem VenueService.setStatus.
  ADMIN_LOCKED
}

model Venue {
  id                String         @id @default(cuid())
  slug              String         @unique
  name              String
  description       String?
  status            VenueStatus    @default(DRAFT)
  // ⚠️ Hai cấp: phường/xã → tỉnh/thành. Cấp quận/huyện đã bỏ từ 01/07/2025.
  address           String
  ward              String
  province          String
  wardCode          String?        @map("ward_code")
  provinceCode      String?        @map("province_code")
  inactiveNote      String?        @map("inactive_note")
  lat               Float?
  lng               Float?
  phone             String?
  email             String?
  amenities         String[]       @default([])
  bankName          String?        @map("bank_name")
  bankAccountNumber String?        @map("bank_account_number")
  bankAccountName   String?        @map("bank_account_name")
  commissionRate    Decimal?       @map("commission_rate") @db.Decimal(5, 2)
  holdMinutes       Int?           @map("hold_minutes")
  // Chính sách huỷ RIÊNG của từng sân. Để trống = theo mặc định nền tảng.
  freeCancelHours   Int?           @map("free_cancel_hours")
  cancelFeePercent  Int?           @map("cancel_fee_percent")
  ratingAvg         Decimal        @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount       Int            @default(0) @map("rating_count")
  sportId           String         @map("sport_id")
  sport             Sport          @relation(fields: [sportId], references: [id])
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(3)
  images            VenueImage[]
  hours             VenueHour[]
  members           VenueMember[]
  courts            Court[]
  priceRules        PriceRule[]
  bookings          Booking[]
  reviews           Review[]
  favorites         Favorite[]
  payouts           Payout[]
  earnings          OwnerEarning[]

  @@index([status, province, ward])
  @@index([sportId, status])
  @@index([lat, lng])
  @@map("venues")
}

model VenueImage {
  id         String   @id @default(cuid())
  venueId    String   @map("venue_id")
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  url        String
  // Khoá đối tượng trên kho lưu trữ. Thiếu nó thì xoá dòng này xong file vẫn
  // nằm lại trên S3/R2 vĩnh viễn — và vẫn tính tiền.
  storageKey String?  @map("storage_key")
  isPrimary  Boolean  @default(false) @map("is_primary")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([venueId, sortOrder])
  @@map("venue_images")
}

model VenueHour {
  id          String  @id @default(cuid())
  venueId     String  @map("venue_id")
  venue       Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  weekday     Int
  openMinute  Int     @map("open_minute")
  closeMinute Int     @map("close_minute")
  isClosed    Boolean @default(false) @map("is_closed")

  @@unique([venueId, weekday])
  @@map("venue_hours")
}

enum VenueRole {
  OWNER
  STAFF
}

enum VenueMemberStatus {
  INVITED
  ACTIVE
  DISABLED
}

model VenueMember {
  id          String            @id @default(cuid())
  venueId     String            @map("venue_id")
  venue       Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId      String            @map("user_id")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        VenueRole
  status      VenueMemberStatus @default(ACTIVE)
  permissions String[]          @default([])
  invitedBy   String?           @map("invited_by")
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([venueId, userId])
  @@index([userId, status])
  @@map("venue_members")
}

// Chỉ VẬT LIỆU mặt sân. Trong nhà/ngoài trời là chiều riêng (`Court.isIndoor`)
// — "cỏ nhân tạo trong nhà" là chuyện có thật, gộp một enum là không tả được.
enum CourtSurface {
  NATURAL_GRASS
  ARTIFICIAL_GRASS
  WOOD
  RUBBER
  CONCRETE
  CLAY
  EPOXY
}

model Court {
  id        String          @id @default(cuid())
  venueId   String          @map("venue_id")
  venue     Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sportId   String          @map("sport_id")
  sport     Sport           @relation(fields: [sportId], references: [id])
  name      String
  // Để trống = chưa khai. Thà trống còn hơn đoán bừa một mặt sân sai.
  surface   CourtSurface?
  isIndoor  Boolean         @default(false) @map("is_indoor")
  note      String?
  isActive  Boolean         @default(true) @map("is_active")
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz(3)
  closures  CourtClosure[]
  bookings  Booking[]
  overrides PriceOverride[]

  @@index([venueId, sortOrder])
  @@map("courts")
}

model CourtClosure {
  id        String   @id @default(cuid())
  courtId   String   @map("court_id")
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  startAt   DateTime @map("start_at") @db.Timestamptz(3)
  endAt     DateTime @map("end_at") @db.Timestamptz(3)
  reason    String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([courtId, startAt])
  @@map("court_closures")
}

model PriceRule {
  id           String   @id @default(cuid())
  venueId      String   @map("venue_id")
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  courtId      String?  @map("court_id")
  weekdays     Int[]    @default([])
  startMinute  Int      @map("start_minute")
  endMinute    Int      @map("end_minute")
  pricePerSlot Int      @map("price_per_slot")
  isPeak       Boolean  @default(false) @map("is_peak")
  priority     Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([venueId, priority])
  @@map("price_rules")
}

model PriceOverride {
  id           String   @id @default(cuid())
  courtId      String?  @map("court_id")
  court        Court?   @relation(fields: [courtId], references: [id], onDelete: Cascade)
  venueId      String   @map("venue_id")
  date         DateTime @db.Date
  startMinute  Int      @map("start_minute")
  endMinute    Int      @map("end_minute")
  pricePerSlot Int      @map("price_per_slot")
  isPeak       Boolean  @default(false) @map("is_peak")
  reason       String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([venueId, date])
  @@map("price_overrides")
}

enum BookingStatus {
  HOLDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
}

enum BookingSource {
  WEB
  MOBILE
  COUNTER
}

model Booking {
  id               String              @id @default(cuid())
  code             String              @unique
  venueId          String              @map("venue_id")
  venue            Venue               @relation(fields: [venueId], references: [id])
  courtId          String              @map("court_id")
  court            Court               @relation(fields: [courtId], references: [id])
  userId           String?             @map("user_id")
  user             User?               @relation(fields: [userId], references: [id])
  customerName     String              @map("customer_name")
  customerPhone    String              @map("customer_phone")
  customerNote     String?             @map("customer_note")
  startAt          DateTime            @map("start_at") @db.Timestamptz(3)
  endAt            DateTime            @map("end_at") @db.Timestamptz(3)
  slotCount        Int                 @map("slot_count")
  status           BookingStatus       @default(HOLDING)
  source           BookingSource       @default(WEB)
  subtotal         Int
  discountTotal    Int                 @default(0) @map("discount_total")
  total            Int
  holdExpiresAt    DateTime?           @map("hold_expires_at") @db.Timestamptz(3)
  checkedInAt      DateTime?           @map("checked_in_at") @db.Timestamptz(3)
  cancelledAt      DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelReason     String?             @map("cancel_reason")
  cancelledBy      String?             @map("cancelled_by")
  // Nhóm các lượt của một lịch cố định ("thứ 3 hàng tuần"). Cột trước, tính
  // năng sau — thêm cột vào bảng đã có triệu dòng đắt hơn nhiều.
  recurringGroupId String?             @map("recurring_group_id")
  createdBy        String?             @map("created_by")
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  payments         Payment[]
  redemptions      VoucherRedemption[]
  earning          OwnerEarning?
  review           Review?
  disputes         Dispute[]

  @@index([venueId, startAt])
  @@index([courtId, startAt])
  @@index([userId, startAt])
  @@index([status, holdExpiresAt])
  @@index([recurringGroupId])
  @@map("bookings")
}

enum VoucherType {
  PERCENT
  FIXED
}

model Voucher {
  id           String              @id @default(cuid())
  code         String              @unique
  name         String
  description  String?
  type         VoucherType
  value        Int
  maxDiscount  Int?                @map("max_discount")
  minTotal     Int                 @default(0) @map("min_total")
  venueId      String?             @map("venue_id")
  startAt      DateTime            @map("start_at") @db.Timestamptz(3)
  endAt        DateTime            @map("end_at") @db.Timestamptz(3)
  usageLimit   Int?                @map("usage_limit")
  usagePerUser Int                 @default(1) @map("usage_per_user")
  usedCount    Int                 @default(0) @map("used_count")
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  redemptions  VoucherRedemption[]

  @@index([isActive, startAt, endAt])
  @@map("vouchers")
}

model VoucherRedemption {
  id             String   @id @default(cuid())
  voucherId      String   @map("voucher_id")
  voucher        Voucher  @relation(fields: [voucherId], references: [id])
  bookingId      String   @map("booking_id")
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId         String?  @map("user_id")
  discountAmount Int      @map("discount_amount")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([bookingId])
  @@index([voucherId, userId])
  @@map("voucher_redemptions")
}

enum PaymentReceiver {
  PLATFORM
  VENUE
}

enum PaymentProvider {
  VNPAY
  MOMO
  ZALOPAY
  SEPAY
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  AWAITING_CONFIRMATION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id             String          @id @default(cuid())
  bookingId      String          @map("booking_id")
  booking        Booking         @relation(fields: [bookingId], references: [id])
  provider       PaymentProvider
  status         PaymentStatus   @default(PENDING)
  amount         Int
  merchantRef    String          @unique @map("merchant_ref")
  requestId      String?         @map("request_id")
  providerTxnId  String?         @map("provider_txn_id")
  checkoutUrl    String?         @map("checkout_url")
  qrCodeUrl      String?         @map("qr_code_url")
  deeplink       String?
  transferNote   String?         @map("transfer_note")
  expiresAt      DateTime?       @map("expires_at") @db.Timestamptz(3)
  bankCode       String?         @map("bank_code")
  cardType       String?         @map("card_type")
  responseCode   String?         @map("response_code")
  providerPaidAt DateTime?       @map("provider_paid_at") @db.Timestamptz(3)
  refundedAmount Int             @default(0) @map("refunded_amount")

  receivedBy PaymentReceiver @default(PLATFORM) @map("received_by")

  declaredAt     DateTime? @map("declared_at") @db.Timestamptz(3)
  // Số tiền KHÁCH KHAI đã chuyển. Lệch với `amount` là dấu hiệu đầu tiên của
  // chuyển thiếu hoặc ảnh chụp màn hình của giao dịch khác.
  declaredAmount Int?      @map("declared_amount")
  declaredNote   String?   @map("declared_note")
  proofImageUrl  String?   @map("proof_image_url")

  reviewedBy   String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(3)
  rejectReason String?   @map("reject_reason")

  paidAt     DateTime? @map("paid_at") @db.Timestamptz(3)
  failedAt   DateTime? @map("failed_at") @db.Timestamptz(3)
  failReason String?   @map("fail_reason")

  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  events    PaymentEvent[]
  refunds   Refund[]

  @@index([bookingId])
  @@index([status, createdAt])
  @@index([provider, providerTxnId])
  @@index([status, expiresAt])
  @@index([status, declaredAt])
  @@map("payments")
}

model PaymentEvent {
  id              String          @id @default(cuid())
  paymentId       String?         @map("payment_id")
  payment         Payment?        @relation(fields: [paymentId], references: [id])
  provider        PaymentProvider
  externalEventId String          @map("external_event_id")
  payload         Json
  verified        Boolean         @default(false)
  processedAt     DateTime?       @map("processed_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([provider, externalEventId])
  @@index([paymentId])
  @@map("payment_events")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String       @map("payment_id")
  payment          Payment      @relation(fields: [paymentId], references: [id])
  amount           Int
  reason           String
  status           RefundStatus @default(PENDING)
  merchantRef      String       @unique @map("merchant_ref")
  providerRefundId String?      @map("provider_refund_id")
  responseCode     String?      @map("response_code")
  failReason       String?      @map("fail_reason")

  requestedBy String?   @map("requested_by")
  approvedBy  String?   @map("approved_by")
  refundedAt  DateTime? @map("refunded_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refunds")
}

enum EarningStatus {
  PENDING
  AVAILABLE
  PAID
  REVERSED
}

model OwnerEarning {
  id               String        @id @default(cuid())
  bookingId        String        @unique @map("booking_id")
  booking          Booking       @relation(fields: [bookingId], references: [id])
  venueId          String        @map("venue_id")
  venue            Venue         @relation(fields: [venueId], references: [id])
  grossAmount      Int           @map("gross_amount")
  commissionRate   Decimal       @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Int           @map("commission_amount")
  netAmount        Int           @map("net_amount")
  status           EarningStatus @default(PENDING)
  payoutId         String?       @map("payout_id")
  payout           Payout?       @relation(fields: [payoutId], references: [id])
  availableAt      DateTime?     @map("available_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  @@index([venueId, status])
  @@index([payoutId])
  @@map("owner_earnings")
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

model Payout {
  id                String         @id @default(cuid())
  venueId           String         @map("venue_id")
  venue             Venue          @relation(fields: [venueId], references: [id])
  amount            Int
  status            PayoutStatus   @default(REQUESTED)
  bankName          String         @map("bank_name")
  bankAccountNumber String         @map("bank_account_number")
  bankAccountName   String         @map("bank_account_name")
  requestedBy       String         @map("requested_by")
  approvedBy        String?        @map("approved_by")
  paidAt            DateTime?      @map("paid_at") @db.Timestamptz(3)
  note              String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  earnings          OwnerEarning[]

  @@index([venueId, status])
  @@map("payouts")
}

model Review {
  id             String    @id @default(cuid())
  venueId        String    @map("venue_id")
  venue          Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookingId      String    @unique @map("booking_id")
  booking        Booking   @relation(fields: [bookingId], references: [id])
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  rating         Int
  comment        String?
  ownerReply     String?   @map("owner_reply")
  ownerRepliedAt DateTime? @map("owner_replied_at") @db.Timestamptz(3)
  isHidden       Boolean   @default(false) @map("is_hidden")
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([venueId, isHidden, createdAt])
  @@map("reviews")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId   String   @map("venue_id")
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, venueId])
  @@map("favorites")
}

enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

model Dispute {
  id          String        @id @default(cuid())
  bookingId   String        @map("booking_id")
  booking     Booking       @relation(fields: [bookingId], references: [id])
  userId      String        @map("user_id")
  reason      String
  description String?
  status      DisputeStatus @default(OPEN)
  resolvedBy  String?       @map("resolved_by")
  resolution  String?
  resolvedAt  DateTime?     @map("resolved_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([bookingId])
  @@map("disputes")
}

model Setting {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("settings")
}
