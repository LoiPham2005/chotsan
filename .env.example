# =============================================================================
# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# Mọi biến dưới đây được validate bằng Zod trong `src/lib/env.ts` (web),
# `worker/env.ts`, `realtime/env.ts`: thiếu hoặc sai định dạng thì tiến trình
# fail ngay lúc khởi động, không phải lúc request đầu tiên chạm tới nó.
#
# Dòng bị comment ghi GIÁ TRỊ MẶC ĐỊNH trong mã — bỏ trống cũng được như vậy.
# =============================================================================

# --- Bắt buộc -----------------------------------------------------------------

# Chuỗi kết nối PostgreSQL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chotsan?schema=public"

# Khoá ký session cookie (HS256). Tối thiểu 32 ký tự.
# Sinh khoá mới:  openssl rand -base64 48
SESSION_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu-xxxxx"

# --- URL công khai của app ----------------------------------------------------

# MỘT nguồn cho mọi link TUYỆT ĐỐI phía máy chủ (`appBaseUrl()` trong
# src/lib/env.ts): link trong email (xác thực, đặt lại mật khẩu, đổi email),
# redirect_uri của OAuth và cấu hình passkey (WebAuthn rpID/origin).
#
# ⚠️ Không có mặc định `localhost`, có chủ đích: gửi đi một email chứa link
# localhost thì không rút lại được. Thiếu APP_URL thì dùng NEXT_PUBLIC_APP_URL.
# Thiếu CẢ HAI: gửi email báo lỗi thay vì gửi, nút Google/Apple và passkey bị ẩn.
# Máy dev: bật dòng dưới trước khi thử luồng quên mật khẩu.
# APP_URL=http://localhost:3000

# Bản dùng được ở TRÌNH DUYỆT (Next chỉ nhúng biến có tiền tố NEXT_PUBLIC_, và
# nhúng lúc BUILD). Đặt CÙNG giá trị với APP_URL.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tên hiển thị trong app xác thực (issuer TOTP) và hộp thoại passkey của hệ điều
# hành. Mặc định trong mã đã là "ChốtSân"; chỉ đặt khi muốn tên khác.
APP_NAME="ChốtSân"

# --- Reverse proxy ------------------------------------------------------------
# Số reverse proxy TIN CẬY đứng trước app. IP khách (dùng cho rate limit) lấy
# phần tử thứ `len − hops` của X-Forwarded-For — những phần tử đứng trước đó do
# client tự khai, không tin được.
#
#   1 → Caddy (deploy/Caddyfile) ghi đè X-Forwarded-For bằng IP thật. Mặc định.
#   2 → thêm một tầng nữa phía trước (Cloudflare proxy, load balancer) có nối
#       thêm IP vào header.
#
# ⚠️ Đặt LỚN hơn thực tế là rate limit đếm theo IP của proxy (mọi người chung một
# bộ đếm); đặt NHỎ hơn là client tự khai IP giả để né giới hạn đăng nhập.
# TRUSTED_PROXY_HOPS=1

# --- Chỉ dành cho docker-compose ----------------------------------------------
# Những biến dưới đây KHÔNG có trong `src/lib/env.ts` — ứng dụng không đọc chúng.
# Chỉ `docker-compose.yml` dùng, để dựng container Postgres và map cổng ra máy.
# Bỏ trống thì compose dùng giá trị mặc định ghi sẵn trong ngoặc.
#
# ⚠️ POSTGRES_PORT là cổng lộ ra MÁY THẬT, không phải cổng bên trong container.
# Đổi nó khi 5432 đã bị một Postgres/container khác chiếm — trường hợp rất hay
# gặp khi chạy nhiều dự án cùng lúc. Nhớ sửa cả cổng trong DATABASE_URL cho khớp.
#
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=chotsan
#
# Cổng web lộ ra máy thật.
# APP_PORT=3000

# --- Chỉ dành cho PM2 (ecosystem.config.cjs) ----------------------------------
# PM2 đọc biến của SHELL lúc nạp cấu hình, không đọc .env — nạp trước:
#   set -a && . /etc/chotsan/env && set +a && pnpm pm2:start
#
# Số tiến trình web. >1 hoặc `max` BẮT BUỘC có REDIS_URL: không có thì mỗi tiến
# trình đếm rate limit riêng, ngưỡng chống dò mật khẩu bị nhân lên — cấu hình
# PM2 dừng lại và báo lỗi thay vì cho chạy.
# PM2_INSTANCES=1
#
# Số tiến trình worker. Nhiều worker là an toàn (BullMQ khoá job qua Redis);
# nâng khi hàng đợi thật sự ùn.
# PM2_WORKER_INSTANCES=1

# --- Tuỳ chọn -----------------------------------------------------------------

# Kết nối trực tiếp, bỏ qua connection pooler (Neon / Supabase / PgBouncer).
# Prisma Migrate cần kết nối trực tiếp; runtime thì dùng DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://..."

# Số ngày cookie session trên web còn hiệu lực.
# SESSION_MAX_AGE_DAYS=7

# Cắt mọi phiên cấp TRƯỚC lần đổi/đặt lại mật khẩu gần nhất (cookie web, access
# token, socket realtime) — chậm nhất sau ~60 giây cache. Mặc định BẬT. `0` CHỈ tắt
# phép so mốc mật khẩu: tài khoản BANNED/INACTIVE/đã xoá LUÔN bị cắt. Cái giá: một
# lần đọc cache mỗi request đã đăng nhập (RAM, hoặc Redis khi có REDIS_URL).
# SESSION_STRICT_REVOCATION=1

# --- Token cho client mobile (REST API) ---------------------------------------
# Access token là JWT nên KHÔNG thu hồi được; hạn ngắn chính là thứ giới hạn
# thiệt hại khi token bị lộ. Việc giữ đăng nhập lâu dài do refresh token lo,
# và refresh token nằm trong database nên xoá là mất hiệu lực ngay.
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30

# Tài khoản admin do `pnpm db:seed:prod` tạo ra.
# Bắt buộc phải set khi seed ở môi trường production.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="doi-mat-khau-nay-truoc-khi-len-production"

# --- Xác thực email & đặt lại mật khẩu ----------------------------------------
# Hạn của link trong email. Hai mốc khác nhau vì mức thiệt hại khác nhau: link
# xác thực bị lộ chỉ giúp kẻ khác xác nhận hộ một địa chỉ, còn link đặt lại mật
# khẩu bị lộ là mất tài khoản.
# EMAIL_VERIFICATION_TTL_HOURS=24
# PASSWORD_RESET_TTL_MINUTES=60

# Địa chỉ người gửi trên email hệ thống.
MAIL_FROM="no-reply@example.com"

# Link trong thư dựng từ APP_URL (mục "URL công khai" ở trên).
#
# Gửi thư thật: đặt SMTP_* (mục GỬI EMAIL bên dưới), hoặc viết một object thoả
# interface `Mailer` (src/lib/mailer.ts) rồi gọi setMailer() lúc khởi động — ở CẢ
# `src/instrumentation.ts` (web) lẫn `worker/main.ts` (worker).
# Ở môi trường dev, nội dung email được ghi ra log — lấy link trong đó mà test.

# --- Bật/tắt tiến trình phụ ----------------------------------------------------
# Hai công tắc để dự án nào không cần thì bỏ hẳn, không phải xoá code.
#
# ⚠️ CHỈ NHẬN `1` (bật) hoặc `0` (tắt). KHÔNG dùng true/false.
# Lý do: chính hai biến này được `docker-compose.yml` dùng làm số bản sao của
# service tương ứng (`deploy: replicas: ${QUEUE_ENABLED:-1}`), mà compose chỉ
# hiểu số. Đặt `false` là compose dừng ngay với `strconv.Atoi: parsing "false"`.
#
# Dùng CHUNG một biến cho cả app lẫn compose là có chủ đích. Nếu tách đôi thì
# sẽ có ngày app vẫn đẩy job vào Redis trong khi không worker nào chạy — job
# nằm đó mãi, email không bao giờ gửi, không một dòng log nào báo.
#
# Bỏ trống / không khai báo = BẬT. Không đụng gì thì mọi thứ chạy như cũ.

# Hàng đợi job nền (BullMQ + thư mục worker/).
#   1 → enqueue() đẩy job vào Redis, tiến trình worker xử lý và chạy job theo lịch.
#   0 → enqueue() chạy job NGAY trong request; job theo lịch (nhả giao dịch quá
#       hạn, xuất hoá đơn…) do CHÍNH tiến trình web chạy. Không cần Redis, không
#       cần worker. Kiểm: /api/health → features.schedules = "in-process".
#
# Tắt thì KHÔNG mất tính năng nào, chỉ đổi chỗ chạy. Cái mất là **thử lại tự
# động** của job thường: đang bật, một lần SMTP nghẽn chỉ làm job lùi vài giây
# rồi chạy lại; tắt đi thì lỗi đó bung thẳng ra request và người dùng đăng ký
# hỏng. Dự án gửi mail thật thì nên để bật.
#
# ⚠️ Bật mà thiếu REDIS_URL: máy dev vẫn chạy (job và lịch chạy ngay trong web),
# còn production thì enqueue() NÉM LỖI và KHÔNG lịch nào chạy
# (features.schedules = "off") — chọn một: đặt REDIS_URL, hoặc QUEUE_ENABLED=0.
# QUEUE_ENABLED=1

# Máy chủ WebSocket (thư mục realtime/).
#   1 → dựng tiến trình realtime.
#   0 → không dựng. App Next.js không tự gọi sang realtime nên không có gì hỏng.
#
# ⚠️ Tắt thì nhớ bỏ luôn khối `/socket.io/*` trong deploy/Caddyfile — để lại
# thì proxy trả 502 (trông như hỏng) thay vì 404 (đúng: không có ở đây).
# REALTIME_ENABLED=1

# --- Realtime (WebSocket) -----------------------------------------------------
# Tiến trình riêng: `pnpm realtime:dev`. Xem thư mục realtime/.
# SESSION_SECRET ở trên dùng chung — token web/mobile phải verify được ở đây.
# REALTIME_PORT=3002
# REALTIME_CORS_ORIGIN="http://localhost:3000"

# Redis — dùng cho BA việc, cùng một biến:
#
#   1. Hàng đợi job (BullMQ, kết nối qua gói ioredis).
#   2. Adapter của realtime. Bỏ trống = chạy một instance. BẮT BUỘC từ instance
#      thứ hai trở đi: thiếu nó thì client nối vào máy A không nhận được tin
#      phát từ máy B, và không có lỗi nào cả.
#   3. Rate limit + cache dùng chung giữa các instance. Bỏ trống = đếm trong RAM
#      từng tiến trình, nên ngưỡng thực tế bị nhân lên theo số instance, và mỗi
#      lần deploy là bộ đếm về 0.
#
# Dùng chung một Redis cho cả ba được: mỗi bên có tiền tố khoá riêng.
# REDIS_URL=redis://localhost:6379

# --- Nhật ký thao tác (audit log) ----------------------------------------------
# Giữ bản ghi nhật ký bao nhiêu ngày trước khi job dọn dẹp xoá đi.
# Có yêu cầu tuân thủ (kế toán, y tế, tài chính) thì con số này do quy định quyết
# định, đừng hạ xuống vì database đang đầy.
# AUDIT_RETENTION_DAYS=365

# Số ngày không thấy hoạt động thì coi thiết bị push là chết và dọn đi. Bảng
# này chỉ tăng nếu không có ai dọn.
# DEVICE_STALE_DAYS=180

# --- Job nền (worker) -----------------------------------------------------------
# Số job chạy song song trong MỘT tiến trình worker.
# Job nặng CPU thì hạ xuống; job chủ yếu chờ mạng thì nâng lên được.
# WORKER_CONCURRENCY=5
#
# Cổng /health của worker. Trả kèm số job đang chờ/đang chạy/đã hỏng — đây là
# cách rẻ nhất để nhìn thấy hàng đợi mà không phải gõ redis-cli.
# WORKER_HEALTH_PORT=3003

# Địa chỉ lắng nghe của realtime (cả Socket.IO lẫn /health) và /health của
# worker. Mặc định CHỈ loopback: reverse proxy cùng máy là cửa duy nhất đi vào.
# Docker tự đặt 0.0.0.0 cho realtime (Dockerfile + docker-compose.yml), đừng
# đặt ở đây. Web (Next) dùng biến riêng HOSTNAME.
# HOST=127.0.0.1

# --- Job theo lịch ----------------------------------------------------------------
# Cú pháp cron 5 trường (phút giờ ngày tháng thứ), diễn giải theo giờ VIỆT NAM
# (Asia/Ho_Chi_Minh) dù máy chủ chạy UTC. Dùng chung cho worker và cho tiến trình
# web khi QUEUE_ENABLED=0 (src/jobs/schedules.ts). Biểu thức sai → tiến trình
# dừng ngay lúc khởi động, kèm tên biến.
#
# Nhả chỗ giữ + huỷ giao dịch chờ thanh toán quá hạn. Thưa hơn mỗi phút thì
# khung giờ trống vẫn hiện "đã có người đặt" lâu hơn đúng bằng khoảng đó.
# CRON_EXPIRE_HOLDS="* * * * *"
# Dọn token hết hạn, nhật ký cũ, thiết bị chết.
# CRON_PURGE_EXPIRED="0 3 * * *"
# Xuất hoá đơn hoa hồng cho các tháng đã kết thúc còn thiếu (tự bù tối đa 3 tháng,
# bỏ qua kỳ đã xuất) — chạy MỖI NGÀY để một lần hỏng không phải đợi tới tháng sau.
# CRON_INVOICE_MONTHLY="30 2 * * *"
# Đánh dấu hoá đơn quá hạn.
# CRON_INVOICE_OVERDUE="0 4 * * *"

# --- Chống brute-force theo tài khoản ------------------------------------------
# Bổ sung cho rate-limit theo IP: cặp này chặn nhiều IP cùng dò một tài khoản.
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# --- Đăng nhập mạng xã hội (OAuth) ---------------------------------------------
# Mỗi provider độc lập và tuỳ chọn — thiếu cặp ID/SECRET của provider nào thì
# nút đăng nhập của provider đó tự ẩn/báo lỗi, không làm sập app.
# Redirect URI khai báo trên console của provider phải khớp CHÍNH XÁC 100%:
#   <APP_URL>/api/v1/auth/oauth/<provider>/callback
#
# Chú ý phần `/v1` — sai một ký tự là provider trả về `redirect_uri_mismatch`
# và không có cách nào debug từ phía app. Giá trị thật do `callbackUrl()` trong
# src/lib/oauth/config.ts dựng ra; muốn chắc chắn thì in nó ra rồi dán y nguyên.

# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# Apple không có client secret tĩnh — đây là nguyên liệu để tự ký JWT làm secret
# lúc chạy (xem src/lib/oauth/apple-client-secret.ts). APPLE_PRIVATE_KEY là nội
# dung file .p8 tải từ Apple Developer, giữ nguyên xuống dòng (\n).
# APPLE_CLIENT_ID=""
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---------------------------------------------------------------------------
# XÁC THỰC HAI LỚP (2FA) — mã TOTP 6 số từ Google Authenticator, 1Password…
# ---------------------------------------------------------------------------
# Bí mật TOTP được MÃ HOÁ (AES-256-GCM) trước khi lưu database, nên thiếu khoá
# này là không bật được 2FA — giao diện tự ẩn nút thay vì báo lỗi khi bấm.
#
# Tách khỏi SESSION_SECRET có chủ đích: SESSION_SECRET dùng để KÝ (một chiều,
# xoay lúc nào cũng được, chỉ tốn việc mọi người đăng nhập lại), còn khoá này
# dùng để MÃ HOÁ — xoay nó là mọi bí mật 2FA đang lưu thành rác không giải mã
# được, và toàn bộ người dùng mất quyền truy cập.
#
#   openssl rand -base64 32
# ENCRYPTION_KEY=""

# Hạn của "vé 2FA" — token ngắn hạn cấp sau khi mật khẩu đã đúng nhưng chưa
# nhập mã. Vé càng sống lâu thì cửa sổ để một máy bị chiếm hoàn tất đăng nhập
# càng rộng.
# TWO_FACTOR_CHALLENGE_TTL_MINUTES=5

# ---------------------------------------------------------------------------
# PASSKEY / WebAuthn — vân tay, Face ID, Windows Hello, khoá cứng
# ---------------------------------------------------------------------------
# Bỏ trống cả hai thì lấy theo APP_URL (hoặc NEXT_PUBLIC_APP_URL) — đúng cho
# phần lớn dự án chỉ có một tên miền.
#
# ⚠️ rpID là TÊN MIỀN, không phải URL: "example.com", không có https:// và
# không có cổng. Đăng ký passkey với rpID sai vẫn THÀNH CÔNG rồi không bao giờ
# đăng nhập được — lỗi chỉ lộ ra ở lần thử thứ hai, trên máy người dùng.
#
# Khai WEBAUTHN_ORIGINS khi app mobile hoặc một tên miền phụ cũng dùng chung
# passkey (ngăn cách bằng dấu phẩy).
# WEBAUTHN_RP_ID="example.com"
# WEBAUTHN_ORIGINS="https://example.com,https://app.example.com"

# ---------------------------------------------------------------------------
# XÁC THỰC SỐ ĐIỆN THOẠI (OTP qua SMS) — MẶC ĐỊNH TẮT
# ---------------------------------------------------------------------------
# ⚠️ Khác email, mỗi tin nhắn SMS đều TỐN TIỀN THẬT. Một endpoint gửi SMS không
# giới hạn là một hoá đơn không giới hạn, nên tính năng này phải được bật một
# cách CÓ Ý THỨC — code đã dựng sẵn đầy đủ, chỉ chờ cờ này.
#
# ⚠️ Chưa có nhà cung cấp SMS nào được cắm sẵn: bật cờ ở production mà chưa gọi
# setSmser() (ở cả web lẫn worker) thì mọi lần gửi mã đều LỖI — tiến trình báo
# lỗi ngay lúc khởi động.
#
# Chỉ nhận 1/0, không nhận true/false.
# PHONE_VERIFICATION_ENABLED=0

# Ba mức chặn chi phí, độc lập nhau: hạn của một mã, thời gian chờ giữa hai lần
# gửi, và trần mỗi số mỗi ngày.
# PHONE_OTP_TTL_MINUTES=5
# PHONE_OTP_RESEND_COOLDOWN_SECONDS=60
# PHONE_OTP_MAX_PER_DAY=5

# Số lần nhập sai tối đa cho MỘT mã (email lẫn SMS) trước khi mã bị đốt. Mã 6
# số chỉ có 10^6 khả năng — không có trần này thì cứ thử là ra.
# VERIFICATION_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# GỬI EMAIL (SMTP)
# ---------------------------------------------------------------------------
# Thiếu SMTP_HOST (và không setMailer):
#   - dev  → email được GHI RA LOG thay vì gửi đi — đủ để phát triển, và không
#            bao giờ vô tình gửi thư thật cho địa chỉ trong dữ liệu mẫu;
#   - production → gửi thư NÉM LỖI (và báo lỗi ngay lúc khởi động) — không lặng
#            lẽ nuốt email "quên mật khẩu" của người dùng.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=""
# SMTP_PASSWORD=""

# ---------------------------------------------------------------------------
# KHO TỆP (S3 hoặc tương thích: Cloudflare R2, MinIO, Vietnix…)
# ---------------------------------------------------------------------------
# ⚠️ Mã CHƯA có bản cài đặt S3: đặt các biến dưới đây thôi là CHƯA đủ. Phải viết
# một object thoả interface `Storage` (src/lib/storage.ts) rồi gọi setStorage()
# lúc khởi động. Chưa cắm thì dev ghi ra `public/uploads/`, còn production trả
# 503 "chưa cấu hình nơi lưu tệp" — lặng lẽ ghi vào đĩa của container là mất
# sạch file sau mỗi lần deploy.
#
# S3_FORCE_PATH_STYLE=1 cho MinIO và vài nhà cung cấp nội địa; AWS và R2 dùng
# virtual-hosted (để 0).
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL=""
# S3_FORCE_PATH_STYLE=0
